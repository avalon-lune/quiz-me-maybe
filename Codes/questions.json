            "C": "192.0.2.10",
            "D": "203.0.113.20"
          },
          "answer": "B",
          "time_limit": 10,
          "points": 100
        },
        {
          "question_id": "net_04",
          "text": "A blocking recv(4096) on a connected TCP socket returns b''. What does this indicate?",
          "options": {
            "A": "The next message is exactly 4096 bytes long",
            "B": "No bytes are available yet, but the peer is guaranteed connected",
            "C": "The message contains an empty JSON object",
            "D": "The peer has closed its sending direction"
          },
          "answer": "D",
          "time_limit": 20,
          "points": 200
        },
        {
