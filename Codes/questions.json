          "points": 100
        },
        {
          "question_id": "net_02",
          "text": "Why does a TCP application need a framing rule?",
          "options": {
            "A": "To assign an IP address to the server",
            "B": "To disable retransmission",
            "C": "To recover individual messages from the byte stream",
            "D": "To convert TCP into a broadcast protocol"
